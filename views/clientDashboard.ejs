<section class="page-hero" style="padding: 2rem 0 1.5rem;">
  <div class="shell">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
      <div>
        <p class="eyebrow" style="color: #38bdf8; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem;">Client Dashboard</p>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(1.6rem, 5vw, 2.2rem); color: #fff; margin: 0;">Welcome, <%= sessionUser ? sessionUser.name || 'Client' : 'Client' %> 👋</h1>
        <p style="color: #94a3b8; margin: 0.4rem 0 0; font-size: 0.9rem;">Manage your bookings, find professionals, and track your work.</p>
      </div>
      <a href="/client/settings" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: #e2e8f0; font-size: 0.88rem; font-weight: 600; text-decoration: none;">⚙️ Settings</a>
    </div>
  </div>
</section>

<section class="section shell" style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 3rem;">

  <!-- Quick Actions -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">
    <a href="/findHelpNow" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(56,189,248,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">🔍</span>
      <strong style="color: #38bdf8; font-size: 0.9rem; font-weight: 700;">Find Professional</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Book verified staff</span>
    </a>
    <a href="/work" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(139,92,246,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">📋</span>
      <strong style="color: #a78bfa; font-size: 0.9rem; font-weight: 700;">Post Work</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Upload requirements</span>
    </a>
    <a href="/chat" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(74,222,128,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">💬</span>
      <strong style="color: #4ade80; font-size: 0.9rem; font-weight: 700;">Messages</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Chat with pros</span>
    </a>
    <a href="/client/partners" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(245,158,11,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">🏢</span>
      <strong style="color: #f59e0b; font-size: 0.9rem; font-weight: 700;">Partner Agencies</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Agent contact &amp; address</span>
    </a>
    <a href="/client/settings" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(148,163,184,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">⚙️</span>
      <strong style="color: #cbd5e1; font-size: 0.9rem; font-weight: 700;">Settings</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Profile & history</span>
    </a>
  </div>

  <!-- Notice -->
  <%- include('partials/notice') %>

  <!-- Live Bookings -->
  <div class="glass-panel" style="border-radius: 24px; padding: 2rem; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7); margin-bottom: 2rem;" data-reveal>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <p class="card-kicker" style="color: #38bdf8; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.3rem;">Active</p>
        <h2 style="color: #fff; font-size: 1.4rem; font-weight: 800; margin: 0;">Current Bookings</h2>
      </div>
      <a href="/findHelpNow" class="button button-primary" style="padding: 0.65rem 1.5rem; font-size: 0.88rem;">+ New Booking</a>
    </div>

    <% 
      const liveBookings = (dashboardData && dashboardData.bookings) ? dashboardData.bookings.filter(function(b) { 
        return b.status === 'pending' || b.status === 'accepted' || b.status === 'confirmed' || b.status === 'active'; 
      }) : [];
    %>

    <% if (!liveBookings.length) { %>
    <div style="text-align: center; padding: 3rem; color: #64748b;">
      <span style="font-size: 2.5rem; display: block; margin-bottom: 0.75rem;">📭</span>
      <h3 style="color: #94a3b8; margin-bottom: 0.5rem;">No active bookings</h3>
      <p style="font-size: 0.9rem;">Book a professional to get started.</p>
      <a href="/findHelpNow" class="button button-primary" style="margin-top: 1rem;">Find a Professional</a>
    </div>
    <% } %>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% liveBookings.forEach(function(booking) { %>
      <% 
        var statusColor = '#94a3b8';
        var statusBg = 'rgba(148,163,184,0.1)';
        if (booking.status === 'accepted' || booking.status === 'confirmed') { statusColor = '#4ade80'; statusBg = 'rgba(74,222,128,0.1)'; }
        else if (booking.status === 'pending') { statusColor = '#f59e0b'; statusBg = 'rgba(245,158,11,0.1)'; }
      %>
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px;">
          <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
            <strong style="color: #fff; font-size: 1rem;"><%= booking.professionalName || 'Professional' %></strong>
            <span style="background: <%= statusBg %>; color: <%= statusColor %>; font-size: 0.72rem; font-weight: 700; padding: 2px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.04em;"><%= booking.status %></span>
          </div>
          <p style="color: #64748b; font-size: 0.82rem; margin: 0 0 0.25rem;">📋 <%= booking.serviceName || 'Service' %> &nbsp;|&nbsp; 📅 <%= booking.preferredDate || '—' %> @ <%= booking.preferredTimeSlot || '—' %></p>
          <p style="color: #64748b; font-size: 0.82rem; margin: 0;">📍 <%= booking.addressArea || '—' %> &nbsp;|&nbsp; Booking #<%= booking.bookingCode || booking.id %></p>
        </div>
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: center;">
          <a href="/client/bookings/<%= booking.id %>/invoice" style="padding: 0.55rem 1rem; background: rgba(56,189,248,0.1); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); border-radius: 8px; font-size: 0.82rem; font-weight: 700; text-decoration: none;">📄 Invoice</a>
          <form method="POST" action="/client/bookings/<%= booking.id %>/cancel" style="margin:0;" onsubmit="return confirm('Cancel this booking?')">
            <button type="submit" style="padding: 0.55rem 1rem; background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); border-radius: 8px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">Cancel</button>
          </form>
        </div>
      </div>
    <% }); %>
    </div>
  </div>

  <!-- History (collapsible) -->
  <div class="glass-panel" style="border-radius: 24px; border: 1px solid rgba(255,255,255,0.08); background: rgba(15,23,42,0.5);" data-reveal>
    <button type="button" onclick="this.nextElementSibling.classList.toggle('hidden-hist')" style="width: 100%; text-align: left; padding: 1.25rem 2rem; background: none; border: none; color: #94a3b8; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: space-between;">
      <span>📂 Booking History</span>
      <span style="font-size: 0.75rem;">▼ Show/Hide</span>
    </button>
    <div class="hidden-hist" style="display: none; padding: 0 2rem 2rem;">
      <%
        const histBookings = (dashboardData && dashboardData.bookings) ? dashboardData.bookings.filter(function(b) {
          return b.status === 'completed' || b.status === 'cancelled';
        }) : [];
      %>
      <% if (!histBookings.length) { %>
        <p style="color: #64748b; text-align: center; padding: 1.5rem 0;">No completed or cancelled bookings yet.</p>
      <% } %>
      <% histBookings.forEach(function(booking) { %>
        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
          <div>
            <strong style="color: #e2e8f0; font-size: 0.92rem;"><%= booking.professionalName || 'Professional' %></strong>
            <p style="color: #64748b; font-size: 0.8rem; margin: 0.2rem 0 0;"><%= booking.serviceName %> — <%= booking.preferredDate %> | <span style="color: <%= booking.status === 'completed' ? '#4ade80' : '#f43f5e' %>;">
              <%= booking.status %></span></p>
          </div>
          <% if (booking.status === 'completed') { %>
          <a href="/client/bookings/<%= booking.id %>/invoice" style="padding: 0.45rem 0.85rem; background: rgba(56,189,248,0.08); color: #38bdf8; border: 1px solid rgba(56,189,248,0.2); border-radius: 8px; font-size: 0.8rem; font-weight: 700; text-decoration: none;">📄 Invoice</a>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>

</section>

<style>
@media (max-width: 640px) {
  .section { padding: 1rem 0.75rem; }
  div[style*='grid-template-columns: repeat(4'] { grid-template-columns: repeat(2, 1fr) !important; }
}
</style>
