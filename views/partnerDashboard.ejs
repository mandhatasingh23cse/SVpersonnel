<section class="page-hero" style="padding: 2rem 0 1.5rem;">
  <div class="shell">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
      <div>
        <p class="eyebrow" style="color: #f59e0b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem;">SV Agency Workspace</p>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(1.6rem, 5vw, 2.2rem); color: #fff; margin: 0;"><%= dashboardData.partner.business_name %></h1>
        <p style="color: #94a3b8; margin: 0.4rem 0 0; font-size: 0.9rem;">City: <%= dashboardData.partner.city %> | Registered as: <%= dashboardData.partner.full_name %></p>
      </div>
      <a href="/partner/settings" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: #e2e8f0; font-size: 0.88rem; font-weight: 600; text-decoration: none;">⚙️ Settings</a>
    </div>
  </div>
</section>

<section class="section shell" style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 3rem;">
  <%- include("partials/notice") %>

  <!-- Status Alert Banner -->
  <% if (!dashboardData.partner.is_verified) { %>
    <div class="glass-panel animate-fade-in" style="padding: 1.5rem 2rem; border-radius: 12px; border: 1px solid rgba(239, 68, 68, 0.3); background: rgba(239, 68, 68, 0.08); margin-bottom: 2.5rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
      <span style="font-size: 2.2rem; align-self: center;">⏳</span>
      <div style="flex: 1; min-width: 250px;">
        <h3 style="color: #fca5a5; margin: 0 0 0.25rem; font-size: 1.1rem; font-weight: 700;">Verification Pending</h3>
        <p style="color: #f3f4f6; font-size: 0.88rem; margin: 0; line-height: 1.4;">
          Your agency credentials are under review. You can add professionals, but client bookings and payouts are locked until verified.
        </p>
      </div>
    </div>
  <% } %>

  <!-- Overview Stats Grid -->
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2.5rem;">
    <!-- Available Balance -->
    <div class="glass-panel" style="padding: 1.5rem; border-radius: 18px; border: 1px solid rgba(52,211,153,0.3); text-align: center;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: #34d399; font-weight: 700; letter-spacing: 0.05em;">Available Balance</span>
      <strong style="display: block; font-size: 2.2rem; color: #fff; font-family: 'Outfit', sans-serif; margin-top: 0.5rem;">₹<%= dashboardData.wallet.available_inr %></strong>
    </div>

    <!-- Pending Payout -->
    <div class="glass-panel" style="padding: 1.5rem; border-radius: 18px; border: 1px solid rgba(245,158,11,0.3); text-align: center;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: #f59e0b; font-weight: 700; letter-spacing: 0.05em;">Pending Payout</span>
      <strong style="display: block; font-size: 2.2rem; color: #fff; font-family: 'Outfit', sans-serif; margin-top: 0.5rem;">₹<%= dashboardData.wallet.pending_inr %></strong>
    </div>

    <!-- Total Agency Earnings -->
    <div class="glass-panel" style="padding: 1.5rem; border-radius: 18px; border: 1px solid rgba(56,189,248,0.3); text-align: center;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: #38bdf8; font-weight: 700; letter-spacing: 0.05em;">Total Net Earned</span>
      <strong style="display: block; font-size: 2.2rem; color: #fff; font-family: 'Outfit', sans-serif; margin-top: 0.5rem;">₹<%= dashboardData.wallet.total_earned_inr %></strong>
    </div>

    <!-- Managed Professionals Count -->
    <a href="/partner/professionals" class="glass-panel" style="padding: 1.5rem; border-radius: 18px; border: 1px solid rgba(167,139,250,0.3); text-align: center; text-decoration: none; display: block;">
      <span style="font-size: 0.8rem; text-transform: uppercase; color: #a78bfa; font-weight: 700; letter-spacing: 0.05em;">Professionals Managed</span>
      <strong style="display: block; font-size: 2.2rem; color: #fff; font-family: 'Outfit', sans-serif; margin-top: 0.5rem;"><%= dashboardData.professionals.length %></strong>
    </a>
  </div>

  <div class="partner-dashboard-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <!-- LEFT PANEL: Manage Professionals -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Section 1: Register New Professional -->
      <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7);">
        <h2 style="font-family: 'Outfit', sans-serif; color: #fff; margin: 0 0 1.5rem;">Add Professional to Agency</h2>

        <form action="/partner/professionals/create" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Full Name</span>
              <input type="text" name="fullname" required placeholder="Staff Full Name" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Username</span>
              <input type="text" name="username" required placeholder="unique_staff" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Email Address</span>
              <input type="email" name="email" placeholder="Optional" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Phone Number</span>
              <input type="tel" name="phone" required placeholder="Phone number" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Experience (Years)</span>
              <input type="number" name="experience" required min="0" placeholder="Years" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
            <label class="field-group">
              <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Log-in Password</span>
              <input type="password" name="password" required placeholder="Staff password" class="form-input" style="width: 100%; padding: 0.75rem 1rem; border-radius: 12px; background: rgba(0,0,0,0.5); color: #fff; border: 1px solid rgba(255,255,255,0.15);">
            </label>
          </div>
          
          <input type="hidden" name="city" value="<%= dashboardData.partner.city %>">
          <input type="hidden" name="area" value="Main">
          
          <!-- Skill Category assignment -->
          <div style="background: rgba(15,23,42,0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
            <span style="font-size: 0.88rem; font-weight: 700; color: #38bdf8; display: block;">Assign Service Categories (Rates fixed by Admin)</span>

            <div style="display: flex; gap: 1rem; align-items: flex-end;">
              <label style="flex: 1;">
                <span style="font-size: 0.8rem; font-weight: 600; color: #f8fafc; display: block; margin-bottom: 0.4rem;">Select Category</span>
                <select id="builderCategorySelect" class="form-select" style="width: 100%; background: #1e293b; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 10px 14px; color: #fff;">
                  <option value="">-- Select Service Category --</option>
                  <% services.forEach(function(svc) { %>
                    <option value="<%= svc.id %>" data-name="<%= svc.name %>" data-subskills='<%= JSON.stringify(svc.subskills || []) %>'><%= svc.name %></option>
                  <% }) %>
                </select>
              </label>
              <button type="button" id="btnAddSkillToStaff" class="button button-primary" style="padding: 10px 16px; border-radius: 8px; font-weight: bold;">+ Add</button>
            </div>

            <!-- Assigned Skills Table -->
            <div id="assignedSkillsContainer" style="display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.5rem;">
              <p id="noSkillsNotice" style="font-size: 0.82rem; color: #64748b; margin: 0; padding: 0.8rem; border: 1px dashed rgba(255,255,255,0.1); border-radius: 8px; text-align: center;">No categories assigned yet.</p>
            </div>
            <input type="hidden" name="assignedSkillsJson" id="assignedSkillsJsonInput" value="[]">
          </div>

          <button type="submit" class="button button-primary button-block" style="background: linear-gradient(135deg, #f59e0b, #d97706); border: none; font-weight: bold; border-radius: 12px; margin-top: 1rem; padding: 14px; font-size: 1.05rem;">
            Create Professional Profile
          </button>
        </form>
      </div>

      <!-- Section 2: List of Managed Staff -->
      <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="font-family: 'Outfit', sans-serif; color: #fff; margin: 0;">Verified Staff</h2>
          <a href="/partner/professionals" style="color: #38bdf8; font-weight: 700; font-size: 0.9rem; text-decoration: none;">View Directory ›</a>
        </div>
        
        <% if (!dashboardData.professionals.length) { %>
          <p style="text-align: center; color: #64748b; padding: 1rem 0;">No professionals added yet.</p>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% dashboardData.professionals.slice(0, 5).forEach(function (pro) { %>
              <div style="padding: 1rem; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <strong style="color: #fff; font-size: 1rem; display: block;"><%= pro.full_name %></strong>
                  <span style="font-size: 0.8rem; color: #94a3b8; display: block;">Username: <%= pro.username %> | <%= pro.years_experience %> yrs exp</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- RIGHT PANEL: Withdrawals & Billing Operations -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Section A: Request Payout -->
      <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7);">
        <h2 style="font-family: 'Outfit', sans-serif; color: #fff; margin: 0 0 0.5rem;">Withdraw Payout</h2>
        <p style="color: #94a3b8; font-size: 0.88rem; margin-bottom: 1.5rem;">Available earnings can be requested once every 7 days.</p>

        <% if (dashboardData.partner.is_verified) { %>
          <form action="/partner/withdraw" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <label class="field-group">
              <span style="font-size: 0.85rem; font-weight: 600; color: #94a3b8;">Amount to Withdraw (₹)</span>
              <input type="number" name="amount" min="1" max="<%= dashboardData.wallet.available_inr %>" required placeholder="Max ₹<%= dashboardData.wallet.available_inr %>" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 12px 16px; color: #fff; font-size: 1.1rem; font-weight: bold; width: 100%;">
            </label>
            <label class="field-group">
              <span style="font-size: 0.85rem; font-weight: 600; color: #94a3b8;">Bank Account Details</span>
              <textarea name="bankDetails" required rows="3" placeholder="Bank Name / Acc No / IFSC" style="background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; padding: 12px 16px; color: #fff; font-size: 0.9rem; resize: none; width: 100%;"></textarea>
            </label>
            <button type="submit" class="button button-primary button-block" style="background: linear-gradient(135deg, #10b981, #059669); border: none; font-weight: bold; border-radius: 12px; padding: 12px; font-size: 1rem;">
              Request Bank Payout
            </button>
          </form>
        <% } else { %>
          <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 10px; padding: 1.25rem; font-size: 0.85rem; color: #fca5a5; line-height: 1.5; text-align: center;">
            🔒 Withdrawals are locked until your agency is verified by the administrator.
          </div>
        <% } %>
      </div>

      <!-- Section B: Withdrawals Ledger -->
      <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7);">
        <h2 style="font-family: 'Outfit', sans-serif; color: #fff; margin: 0 0 1.5rem;">Withdrawal History</h2>

        <% if (!dashboardData.withdrawals.length) { %>
          <p style="text-align: center; color: #64748b; font-size: 0.9rem;">No payouts requested yet.</p>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% dashboardData.withdrawals.forEach(function (w) { %>
              <div style="padding: 1rem; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <strong style="color: #fff; font-size: 1.05rem;">₹<%= w.amount_inr %></strong>
                  <span style="display: block; font-size: 0.78rem; color: #94a3b8; margin-top: 0.15rem;"><%= w.created_at.substring(0, 10) %></span>
                </div>
                <div>
                  <span style="padding: 0.2rem 0.6rem; border-radius: 99px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; <%= w.status === 'completed' ? 'background: rgba(16,185,129,0.15); color: #34d399;' : 'background: rgba(245,158,11,0.15); color: #fb7185;' %>">
                    <%= w.status %>
                  </span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Booking and Earnings Ledger -->
  <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7); margin-top: 2rem;">
    <h2 style="font-family: 'Outfit', sans-serif; color: #fff; margin: 0 0 1.5rem;">Agency Bookings & Payout Ledger</h2>
    
    <% if (!dashboardData.bookings.length) { %>
      <p style="text-align: center; color: #64748b; padding: 2rem 0;">No booking records found.</p>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 600px;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.15);">
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Code</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Professional</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Client</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Gross</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Fee (20%)</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Net</th>
              <th style="padding: 12px; color: #94a3b8; font-size: 0.85rem; font-weight: 600;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% dashboardData.bookings.forEach(function (b) { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 12px; color: #38bdf8;"><%= b.booking_code %></td>
                <td style="padding: 12px; color: #fff;"><%= (dashboardData.professionals.find(p => p.id === b.professional_id) || {}).full_name || 'Staff' %></td>
                <td style="padding: 12px; color: #cbd5e1;"><%= b.clients ? b.clients.full_name : 'Guest' %></td>
                <td style="padding: 12px; color: #fff;">₹<%= b.budget_inr %></td>
                <td style="padding: 12px; color: #f43f5e;">₹<%= Math.round(b.budget_inr * 0.20) %></td>
                <td style="padding: 12px; color: #34d399; font-weight: bold;">₹<%= b.budget_inr - Math.round(b.budget_inr * 0.20) %></td>
                <td style="padding: 12px;">
                  <span style="padding: 0.15rem 0.5rem; border-radius: 99px; font-size: 0.72rem; text-transform: uppercase;
                    <%= b.status === 'completed' ? 'background: rgba(16,185,129,0.15); color: #34d399;' : (b.status === 'cancelled' ? 'background: rgba(239,68,68,0.15); color: #f87171;' : 'background: rgba(245,158,11,0.15); color: #fbbf24;') %>">
                    <%= b.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<style>
@media (max-width: 900px) {
  .partner-dashboard-grid { grid-template-columns: 1fr !important; }
  div[style*='grid-template-columns: repeat(4'] { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 600px) {
  div[style*='grid-template-columns: repeat(4'] { grid-template-columns: 1fr !important; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const categorySelect = document.getElementById("builderCategorySelect");
  const btnAddSkill = document.getElementById("btnAddSkillToStaff");
  const assignedContainer = document.getElementById("assignedSkillsContainer");
  const noSkillsNotice = document.getElementById("noSkillsNotice");
  const assignedJsonInput = document.getElementById("assignedSkillsJsonInput");

  let assignedSkillsList = [];

  function renderAssignedSkills() {
    if (!assignedContainer) return;
    if (assignedSkillsList.length === 0) {
      if (noSkillsNotice) noSkillsNotice.style.display = "block";
      assignedContainer.innerHTML = '<p id="noSkillsNotice" style="font-size: 0.82rem; color: #64748b; margin: 0; padding: 0.8rem; border: 1px dashed rgba(255,255,255,0.1); border-radius: 8px; text-align: center;">No categories assigned yet.</p>';
    } else {
      assignedContainer.innerHTML = assignedSkillsList.map((item, idx) => `
        <div style="background: rgba(30,41,59,0.75); border: 1px solid rgba(56,189,248,0.3); border-radius: 8px; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
          <div>
            <strong style="color: #38bdf8; font-size: 0.96rem;">${item.categoryName}</strong>
          </div>
          <button type="button" onclick="removeAssignedSkill(${idx})" style="background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.4); border-radius: 6px; padding: 5px 12px; font-size: 0.78rem; cursor: pointer; font-weight: bold;">Remove</button>
        </div>
      `).join("");
    }
    if (assignedJsonInput) {
      assignedJsonInput.value = JSON.stringify(assignedSkillsList);
    }
  }

  window.removeAssignedSkill = function(idx) {
    assignedSkillsList.splice(idx, 1);
    renderAssignedSkills();
  };

  if (btnAddSkill) {
    btnAddSkill.addEventListener("click", function() {
      const selectedOpt = categorySelect ? categorySelect.options[categorySelect.selectedIndex] : null;
      if (!selectedOpt || !selectedOpt.value) {
        alert("Please select a Service Category first.");
        return;
      }
      const categoryId = selectedOpt.value;
      const categoryName = selectedOpt.getAttribute("data-name") || selectedOpt.text;
      
      const existingIdx = assignedSkillsList.findIndex(item => item.categoryId == categoryId);
      if (existingIdx === -1) {
        assignedSkillsList.push({
          categoryId: Number(categoryId),
          categoryName: categoryName,
          rate: 500 // placeholder since admin controls rate
        });
      }
      renderAssignedSkills();
    });
  }

  const regForm = document.querySelector('form[action="/partner/professionals/create"]');
  if (regForm) {
    regForm.addEventListener("submit", function(e) {
      if (assignedSkillsList.length === 0) {
        e.preventDefault();
        alert("Please assign at least one Service Category to this staff member before submitting.");
        return false;
      }
    });
  }
});
</script>
