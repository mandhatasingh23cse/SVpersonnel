<section class="section shell animate-fade-in" style="max-width: 680px; margin: 3rem auto;">
  <div class="glass-panel" style="padding: 3rem 2.5rem; border-radius: 24px; border: 1px solid rgba(34, 197, 94, 0.4); background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(22, 101, 52, 0.15)); text-align: center; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);">
    
    <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem auto; border-radius: 50%; background: linear-gradient(135deg, #22c55e, #15803d); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: #fff; box-shadow: 0 10px 25px rgba(34, 197, 94, 0.4);">
      ✓
    </div>

    <span style="background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.4); padding: 4px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; display: inline-block; margin-bottom: 1rem;">
      Payment Verified &amp; Confirmed
    </span>

    <h1 style="color: #fff; font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem 0;">Payment Successful!</h1>
    <p style="color: #94a3b8; font-size: 1rem; margin: 0 0 2rem 0; line-height: 1.5;">
      Thank you! Your payment has been processed securely via <strong>PayU Official Gateway</strong> and your account has been updated.
    </p>

    <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; text-align: left; margin-bottom: 2rem;">
      <h4 style="color: #cbd5e1; margin: 0 0 1rem 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 0.5rem;">
        Transaction Summary
      </h4>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; font-size: 0.9rem;">
        <div>
          <span style="color: #64748b; font-size: 0.8rem; display: block;">Transaction ID</span>
          <strong style="color: #f1f5f9; font-family: monospace; font-size: 0.95rem;"><%= txnid || 'WB_SUCCESS' %></strong>
        </div>
        <% if (typeof mihpayid !== 'undefined' && mihpayid) { %>
          <div>
            <span style="color: #64748b; font-size: 0.8rem; display: block;">PayU Reference ID</span>
            <strong style="color: #f1f5f9; font-family: monospace; font-size: 0.95rem;"><%= mihpayid %></strong>
          </div>
        <% } %>
        <div>
          <span style="color: #64748b; font-size: 0.8rem; display: block;">Amount Paid</span>
          <strong style="color: #4ade80; font-size: 1.1rem;">₹<%= amount || '50.00' %></strong>
        </div>
        <div>
          <span style="color: #64748b; font-size: 0.8rem; display: block;">Item / Description</span>
          <strong style="color: #f1f5f9;"><%= productinfo || 'SV Personnels Service' %></strong>
        </div>
      </div>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center;">
      <a href="/invoice/txnid/<%= txnid %>" target="_blank" class="button" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); padding: 0.85rem 1.5rem; border-radius: 12px; font-weight: 700; text-decoration: none;">
        📄 View &amp; Download GST Invoice ›
      </a>
      <a href="/client/dashboard" class="button button-primary" style="background: linear-gradient(135deg, #22c55e, #16a34a); color: #000; border: none; padding: 0.85rem 1.8rem; border-radius: 12px; font-weight: 800; text-decoration: none;">
        🚀 Go to Client Dashboard ›
      </a>
      <a href="/work" class="button button-primary" style="background: linear-gradient(135deg, #a78bfa, #7c3aed); color: #fff; border: none; padding: 0.85rem 1.5rem; border-radius: 12px; font-weight: 700; text-decoration: none;">
        💼 Post &amp; View Jobs ›
      </a>
    </div>

  </div>
</section>
