<link rel="stylesheet" href="/workforce.css"><div class="workforce"><section class="wf-shell"><a href="/">← Home</a><h1>Find professionals</h1><form class="wf-search" action="/discover"><label>Service<input name="skill" value="<%= skill %>"></label><label>Location<input data-free-city name="city" value="<%= city %>"></label><button>Search</button></form>
<% if(error){ %><p role="alert">Search is temporarily unavailable. Please try again.</p><% }else if(!workers.length){ %><h2>No matching professionals</h2><p>Try another service or search a wider area.</p><% }else{ workers.forEach(worker=>{ %><article><h2><%= worker.name %></h2><p><%= worker.city %></p><a href="/book-service/<%= encodeURIComponent(worker.id) %>">View booking options</a></article><% }) } %></section></div>
