<section class="page-hero">
  <div class="shell page-hero-content">
    <p class="eyebrow" style="color: #f59e0b; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;">Agency Settings</p>
    <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(1.8rem, 4vw, 2.5rem); color: #fff; margin: 0 0 0.5rem;">Partner Agency Settings &amp; Support</h1>
    <p style="color: #94a3b8; max-width: 600px; margin: 0 auto; font-size: 1rem;">Update your agency details, manage contact information, check support inquiry history, or update security preferences.</p>
  </div>
</section>

<section class="section shell dashboard-shell" style="padding-top: 2rem; padding-bottom: 4rem;">
  <%- include("partials/notice") %>

  <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 880px; margin: 0 auto;">
    
    <!-- Agency Profile Update Form -->
    <article class="glass-panel" style="padding: 2.5rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.85);">
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.78rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.3rem;">Agency Profile</span>
        <h2 style="color: #fff; margin: 0; font-size: 1.5rem;">Edit Partner Agency Details</h2>
      </div>

      <form method="POST" action="/partner/settings" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 1.25rem;">
          <label style="display: flex; flex-direction: column; gap: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">Agency Name</span>
            <input type="text" name="name" value="<%= partner.name || sessionUser.name %>" required style="padding: 0.75rem 1rem; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 0.95rem;">
          </label>

          <label style="display: flex; flex-direction: column; gap: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">Email Address (Username)</span>
            <input type="email" value="<%= partner.email || sessionUser.email %>" disabled style="padding: 0.75rem 1rem; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #94a3b8; font-size: 0.95rem; cursor: not-allowed;">
          </label>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 1.25rem;">
          <label style="display: flex; flex-direction: column; gap: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">Contact Phone Number</span>
            <input type="tel" name="phone" value="<%= partner.phone || sessionUser.phone || '' %>" placeholder="Enter contact phone" required style="padding: 0.75rem 1rem; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 0.95rem;">
          </label>

          <label style="display: flex; flex-direction: column; gap: 0.4rem;">
            <span style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">City / Operation Base</span>
            <input type="text" name="city" value="<%= partner.city || sessionUser.city || '' %>" required style="padding: 0.75rem 1rem; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 0.95rem;">
          </label>
        </div>

        <label style="display: flex; flex-direction: column; gap: 0.4rem;">
          <span style="font-size: 0.85rem; font-weight: 600; color: #cbd5e1;">Agency Street Address</span>
          <textarea name="address" rows="3" style="padding: 0.75rem 1rem; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 0.95rem; resize: vertical;"><%= partner.address || sessionUser.address || '' %></textarea>
        </label>

        <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.25rem; margin-top: 0.5rem;">
          <span style="font-size: 0.88rem; font-weight: 700; color: #f59e0b; display: block; margin-bottom: 0.75rem;">Change Password (Optional)</span>
          <input type="password" name="password" placeholder="Leave blank to keep existing password" style="width: 100%; padding: 0.75rem 1rem; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 0.95rem; box-sizing: border-radius;">
        </div>

        <button type="submit" class="button button-primary" style="background: linear-gradient(135deg, #38bdf8, #2563eb); border: none; padding: 0.85rem 2rem; border-radius: 12px; font-weight: 800; font-size: 1rem; color: #fff; cursor: pointer; align-self: flex-start; margin-top: 0.5rem;">
          Save &amp; Update Agency Profile
        </button>
      </form>
    </article>

    <!-- Support Inquiries Section -->
    <article class="glass-panel" style="padding: 2.5rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.85);">
      <span style="font-size: 0.78rem; font-weight: 800; color: #a78bfa; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.3rem;">Support History</span>
      <h2 style="color: #fff; margin: 0 0 0.5rem; font-size: 1.5rem;">Your Support Inquiries</h2>
      <p style="color: #94a3b8; margin-bottom: 1.5rem; font-size: 0.9rem;">
        Support messages sent from <strong><%= sessionUser.email %></strong>.
      </p>

      <% if (typeof messages === 'undefined' || !messages || messages.length === 0) { %>
        <p style="color: #64748b; font-size: 0.9rem; text-align: center; padding: 2rem 0; border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px;">No support inquiries found.</p>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <% messages.forEach(function(msg) { %>
            <div style="padding: 1.25rem; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem;">
                <strong style="color: #fff; font-size: 1rem;"><%= msg.subject || "Support Inquiry" %></strong>
                <span style="padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; <%= msg.status === 'resolved' ? 'background: rgba(52, 211, 153, 0.2); color: #34d399;' : 'background: rgba(245, 158, 11, 0.2); color: #fb7185;' %>">
                  <%= msg.status || 'pending' %>
                </span>
              </div>
              <p style="color: #cbd5e1; font-size: 0.9rem; margin: 0.5rem 0; white-space: pre-line;"><%= msg.message %></p>

              <% if (msg.admin_reply) { %>
                <div style="margin-top: 0.75rem; padding: 1rem; border-radius: 8px; background: rgba(56, 189, 248, 0.1); border-left: 3px solid #38bdf8;">
                  <strong style="color: #38bdf8; font-size: 0.8rem; text-transform: uppercase; display: block; margin-bottom: 0.3rem;">Admin Response:</strong>
                  <p style="color: #fff; font-size: 0.9rem; margin: 0; white-space: pre-line;"><%= msg.admin_reply %></p>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </article>

  </div>
</section>
