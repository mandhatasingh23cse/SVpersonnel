<section class="page-hero" style="padding: 2rem 0 1.5rem;">
  <div class="shell">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
      <div>
        <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
        <p class="eyebrow" style="color: #a78bfa; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem;">Agency Professional Dashboard</p>
        <% } else { %>
        <p class="eyebrow" style="color: #38bdf8; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4rem;">Professional Dashboard</p>
        <% } %>
        <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(1.6rem, 5vw, 2.2rem); color: #fff; margin: 0;">Welcome, <%= dashboardData.profile ? dashboardData.profile.name : 'Professional' %> 👋</h1>
        <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
        <p style="color: #c4b5fd; margin: 0.4rem 0 0; font-size: 0.9rem;">You are managed under <strong><%= typeof partnerAgency !== 'undefined' && partnerAgency ? partnerAgency.business_name : 'your agency' %></strong>. Bookings & payouts are coordinated by your agency.</p>
        <% } else { %>
        <p style="color: #94a3b8; margin: 0.4rem 0 0; font-size: 0.9rem;">Manage your live bookings, earnings, and work feed.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section shell" style="max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 3rem;">

  <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- PARTNER-MANAGED PROFESSIONAL: AGENCY ENVIRONMENT           -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Agency Banner -->
  <div class="glass-panel animate-fade-in" style="padding: 1.5rem 2rem; border-radius: 16px; border: 1px solid rgba(167, 139, 250, 0.35); background: linear-gradient(135deg, rgba(167, 139, 250, 0.12), rgba(139, 92, 246, 0.06)); margin-bottom: 2rem; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;" data-reveal>
    <div style="width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, #a78bfa, #7c3aed); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; flex-shrink: 0;">🏢</div>
    <div style="flex: 1; min-width: 250px;">
      <h3 style="color: #e9d5ff; margin: 0 0 0.3rem; font-size: 1.15rem; font-weight: 800;"><%= typeof partnerAgency !== 'undefined' && partnerAgency ? partnerAgency.business_name : 'Partner Agency' %></h3>
      <p style="color: #c4b5fd; font-size: 0.88rem; margin: 0; line-height: 1.45;">
        <% if (typeof partnerAgency !== 'undefined' && partnerAgency) { %>
          📍 <%= partnerAgency.city %> &nbsp;|&nbsp; 👤 Managed by: <%= partnerAgency.full_name %>
          <% if (partnerAgency.is_verified) { %>&nbsp;|&nbsp; <span style="color: #34d399;">✓ Verified Agency</span><% } %>
        <% } else { %>
          You are operating under a registered agency partner. All bookings and payouts are managed centrally.
        <% } %>
      </p>
    </div>
    <div style="padding: 0.4rem 1rem; background: rgba(167, 139, 250, 0.2); border: 1px solid rgba(167, 139, 250, 0.4); border-radius: 20px; font-size: 0.75rem; font-weight: 800; color: #a78bfa; text-transform: uppercase; letter-spacing: 0.05em;">Agency Staff</div>
  </div>

  <!-- Quick Actions Grid (Simplified for agency pros) -->
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2.5rem;">
    <a href="/chat" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(74,222,128,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">💬</span>
      <strong style="color: #4ade80; font-size: 0.9rem; font-weight: 700;">Messages</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Chat with clients</span>
    </a>
    <div class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(167, 139, 250, 0.2); text-align: center;" data-reveal>
      <span style="font-size: 2rem;">🏢</span>
      <strong style="color: #a78bfa; font-size: 0.9rem; font-weight: 700;">Agency Managed</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Revenue handled by agency</span>
    </div>
  </div>

  <% } else { %>
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- INDIVIDUAL PROFESSIONAL: FULL DASHBOARD                    -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Quick Actions Grid -->
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2.5rem;">
    <a href="/professional/jobs" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(56,189,248,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">💼</span>
      <strong style="color: #38bdf8; font-size: 0.9rem; font-weight: 700;">Work Feed</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Find new jobs</span>
    </a>
    
    <a href="/professional/revenue" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(16,185,129,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">💰</span>
      <strong style="color: #10b981; font-size: 0.9rem; font-weight: 700;">My Revenue</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Earnings & wallet</span>
    </a>

    <a href="/chat" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(74,222,128,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">💬</span>
      <strong style="color: #4ade80; font-size: 0.9rem; font-weight: 700;">Messages</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Chat with clients</span>
    </a>
    <a href="/professional/profile" class="glass-panel" style="display: flex; flex-direction: column; align-items: center; gap: 0.6rem; padding: 1.5rem 1rem; border-radius: 18px; text-decoration: none; border: 1px solid rgba(245,158,11,0.2); transition: all 0.2s; text-align: center;" data-reveal>
      <span style="font-size: 2rem;">👤</span>
      <strong style="color: #f59e0b; font-size: 0.9rem; font-weight: 700;">Profile</strong>
      <span style="color: #64748b; font-size: 0.78rem;">Edit your details</span>
    </a>
  </div>
  <% } %>

  <%- include("partials/notice") %>

  <% if (dashboardData.profile && !dashboardData.profile.isVerified) { %>
    <!-- Identity Verification Notice -->
    <div class="glass-panel" style="padding: 2rem; border-radius: 20px; border: 1px solid rgba(244, 63, 94, 0.4); margin-bottom: 2rem; background: rgba(244, 63, 94, 0.05);" data-reveal>
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
        <span style="font-size: 2rem;">🛡️</span>
        <div>
          <h2 style="color: #f43f5e; margin: 0 0 0.25rem; font-size: 1.3rem;">Verification Pending</h2>
          <p style="color: #cbd5e1; margin: 0; font-size: 0.9rem;">You must verify your identity to accept bookings.</p>
        </div>
      </div>
      <% const hasRealId = (dashboardData.profile.aadhaarPanUrl && dashboardData.profile.aadhaarPanUrl !== 'Aadhaar/PAN'); %>
      <% if (hasRealId) { %>
        <p style="color: #10b981; font-weight: 700;">✅ Documents Submitted. Under review by our admin team.</p>
      <% } else { %>
        <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.5rem;">Please complete your onboarding verification step.</p>
        <a href="/professional/onboarding" class="button button-primary">Go to Onboarding Wizard</a>
      <% } %>
    </div>
  <% } %>

  <!-- Live Bookings -->
  <div class="glass-panel" style="border-radius: 24px; padding: 2rem; border: 1px solid rgba(255,255,255,0.1); background: rgba(15,23,42,0.7); margin-bottom: 2rem;" data-reveal>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <p class="card-kicker" style="color: #38bdf8; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.3rem;">Live</p>
        <h2 style="color: #fff; font-size: 1.4rem; font-weight: 800; margin: 0;">
          <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
            Agency Assigned Bookings
          <% } else { %>
            Active Booking Requests
          <% } %>
        </h2>
      </div>
    </div>

    <% 
      const liveRequests = dashboardData.bookings.filter(b => b.status !== 'completed' && b.status !== 'cancelled');
    %>

    <% if (!liveRequests.length) { %>
      <div style="text-align: center; padding: 3rem; color: #64748b;">
        <span style="font-size: 2.5rem; display: block; margin-bottom: 0.75rem;">📭</span>
        <h3 style="color: #94a3b8; margin-bottom: 0.5rem;">No active requests right now</h3>
        <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
          <p style="font-size: 0.9rem;">Your agency will assign bookings to you. They will appear here.</p>
        <% } else { %>
          <p style="font-size: 0.9rem;">When clients book you, they will appear here.</p>
        <% } %>
      </div>
    <% } %>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% liveRequests.forEach(function(booking) { %>
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
              <strong style="color: #fff; font-size: 1.1rem;"><%= booking.clientName %></strong>
              <span class="result-badge status-badge-<%= booking.status %>"><%= booking.status.toUpperCase() %></span>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 0.3rem;">📋 <%= booking.serviceName %> &nbsp;|&nbsp; 📅 <%= booking.preferredDate %> @ <%= booking.preferredTimeSlot %></p>
            <p style="color: #94a3b8; font-size: 0.85rem; margin: 0;">📍 <strong>Address:</strong> <%= booking.addressArea %></p>
            <p style="color: #94a3b8; font-size: 0.85rem; margin: 0.3rem 0 0;">💰 <strong>Fixed Charge:</strong> ₹<%= booking.budgetInr %></p>
          </div>
          <a href="/chat/client/<%= booking.clientId || '' %>" style="padding: 0.55rem 1rem; background: rgba(74,222,128,0.1); color: #4ade80; border: 1px solid rgba(74,222,128,0.3); border-radius: 8px; font-size: 0.82rem; font-weight: 700; text-decoration: none;">💬 Chat</a>
        </div>

        <!-- ACTIONS based on Status -->
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; width: 100%;">
          <% if (booking.status === "pending") { %>
            <form method="POST" action="/professional/bookings/<%= booking.id %>/status" style="flex: 1; min-width: 140px;">
              <input type="hidden" name="status" value="confirmed">
              <button type="submit" class="button button-primary" style="width: 100%; padding: 0.8rem; font-size: 0.9rem;">Accept Request</button>
            </form>
            <form method="POST" action="/professional/bookings/<%= booking.id %>/status" style="flex: 1; min-width: 140px;" onsubmit="return confirm('Reject this booking?');">
              <input type="hidden" name="status" value="cancelled">
              <button type="submit" class="button" style="width: 100%; padding: 0.8rem; font-size: 0.9rem; background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3);">Reject</button>
            </form>
          <% } %>

          <% 
            let workStartedAt = null;
            let workCompletedAt = null;
            if (booking.details) {
              const startedMatch = booking.details.match(/\[Work Started At:\s*([^\]]+)\]/);
              const completedMatch = booking.details.match(/\[Work Completed At:\s*([^\]]+)\]/);
              if (startedMatch) workStartedAt = startedMatch[1];
              if (completedMatch) workCompletedAt = completedMatch[1];
            }
          %>

          <% if (booking.status === "confirmed" && !workStartedAt) { %>
            <form method="POST" action="/professional/bookings/<%= booking.id %>/start-work" style="display: flex; gap: 0.75rem; align-items: center; width: 100%; flex-wrap: wrap; padding: 1rem; border-radius: 12px; background: rgba(56,189,248,0.05); border: 1px solid rgba(56,189,248,0.2);">
              <div style="flex: 1; min-width: 200px;">
                <span style="font-size: 0.85rem; color: #38bdf8; display: block; margin-bottom: 0.4rem; font-weight: 700;">Enter Client OTP to Start Work</span>
                <input type="text" name="otp" placeholder="6-digit OTP" required style="padding: 10px 14px; font-size: 0.9rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.5); color: #fff; width: 100%;">
              </div>
              <button type="submit" class="button button-primary" style="align-self: flex-end; padding: 10px 24px; font-size: 0.9rem; background: linear-gradient(135deg, #38bdf8, #0284c7); border: none;">Start Work</button>
            </form>
          <% } %>

          <% if (booking.status === "confirmed" && workStartedAt && !workCompletedAt) { %>
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; padding: 1rem; border-radius: 12px; border: 1px solid rgba(16,185,129,0.3); background: rgba(16,185,129,0.05);">
              <div style="text-align: left;">
                <span style="font-weight: 700; color: #10b981; display: block; margin-bottom: 0.25rem;">⚡ Work In Progress</span>
                <span id="timer-<%= booking.id %>" data-start-time="<%= workStartedAt %>" data-fixed-rate="<%= booking.budgetInr %>" style="font-family: monospace; font-size: 1.1rem; font-weight: bold; color: #fff;">00:00:00 (Fixed Charge: ₹<%= booking.budgetInr %>)</span>
              </div>
              <form method="POST" action="/professional/bookings/<%= booking.id %>/complete-work" style="margin: 0;">
                <button type="submit" class="button" style="padding: 10px 24px; background: rgba(16,185,129,0.15); color: #34d399; border: 1px solid rgba(16,185,129,0.3); font-weight: 700;">Complete Work</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>
    </div>
  </div>

  <!-- Upcoming Schedule (for partner-managed professionals) -->
  <% if (dashboardData.profile && dashboardData.profile.isPartnerManaged) { %>
  <div class="glass-panel" style="border-radius: 24px; padding: 2rem; border: 1px solid rgba(167, 139, 250, 0.15); background: rgba(15,23,42,0.7); margin-bottom: 2rem;" data-reveal>
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
      <span style="font-size: 1.5rem;">📅</span>
      <h2 style="color: #fff; font-size: 1.25rem; font-weight: 800; margin: 0;">Your Schedule</h2>
    </div>
    <%
      const upcomingBookings = dashboardData.bookings
        .filter(b => b.status === 'confirmed' || b.status === 'pending')
        .sort((a, b) => new Date(a.preferredDate) - new Date(b.preferredDate))
        .slice(0, 7);
    %>
    <% if (!upcomingBookings.length) { %>
      <p style="color: #64748b; text-align: center; padding: 1.5rem 0; font-size: 0.9rem;">No upcoming scheduled bookings. Your agency will assign jobs as they come in.</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <% upcomingBookings.forEach(function(booking) { %>
          <div style="display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1rem; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
            <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(56, 189, 248, 0.1); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0;">
              <span style="font-size: 0.65rem; color: #38bdf8; font-weight: 800; text-transform: uppercase;"><%= new Date(booking.preferredDate).toLocaleDateString('en-US', { month: 'short' }) %></span>
              <span style="font-size: 1.1rem; color: #fff; font-weight: 800; line-height: 1;"><%= new Date(booking.preferredDate).getDate() %></span>
            </div>
            <div style="flex: 1; min-width: 0;">
              <strong style="color: #e2e8f0; font-size: 0.9rem; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= booking.serviceName %></strong>
              <span style="font-size: 0.78rem; color: #64748b;"><%= booking.preferredTimeSlot %> · <%= booking.clientName %></span>
            </div>
            <span class="result-badge status-badge-<%= booking.status %>" style="font-size: 0.65rem;"><%= booking.status.toUpperCase() %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
  <% } %>

  <!-- History (collapsible) -->
  <div class="glass-panel" style="border-radius: 24px; border: 1px solid rgba(255,255,255,0.08); background: rgba(15,23,42,0.5);" data-reveal>
    <button type="button" onclick="this.nextElementSibling.classList.toggle('hidden-hist')" style="width: 100%; text-align: left; padding: 1.25rem 2rem; background: none; border: none; color: #94a3b8; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: space-between;">
      <span>📂 Booking History</span>
      <span style="font-size: 0.75rem;">▼ Show/Hide</span>
    </button>
    <div class="hidden-hist" style="display: none; padding: 0 2rem 2rem;">
      <%
        const historyRequests = dashboardData.bookings.filter(b => b.status === 'completed' || b.status === 'cancelled');
      %>
      <% if (!historyRequests.length) { %>
        <p style="color: #64748b; text-align: center; padding: 1.5rem 0;">No completed or cancelled requests yet.</p>
      <% } %>
      <% historyRequests.forEach(function(booking) { %>
        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
          <div>
            <strong style="color: #e2e8f0; font-size: 0.92rem;"><%= booking.clientName %></strong>
            <p style="color: #64748b; font-size: 0.8rem; margin: 0.2rem 0 0;"><%= booking.serviceName %> — <%= booking.preferredDate %> | <span style="color: <%= booking.status === 'completed' ? '#4ade80' : '#f43f5e' %>;"><%= booking.status.toUpperCase() %></span></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

</section>

<style>
@media (max-width: 640px) {
  .section { padding: 1rem 0.75rem; }
  div[style*='grid-template-columns: repeat(4'] { grid-template-columns: repeat(2, 1fr) !important; }
  div[style*='grid-template-columns: repeat(3'] { grid-template-columns: repeat(2, 1fr) !important; }
}
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const timerElements = document.querySelectorAll("[id^='timer-']");
    function updateTimers() {
      timerElements.forEach(el => {
        const startTimeStr = el.dataset.startTime;
        const fixedRate = Number(el.dataset.fixedRate || 500);
        if (!startTimeStr) return;

        const start = new Date(startTimeStr).getTime();
        const now = Date.now();
        const diffMs = now - start;

        const hours = Math.floor(diffMs / 3600000);
        const minutes = Math.floor((diffMs % 3600000) / 60000);
        const seconds = Math.floor((diffMs % 60000) / 1000);

        const timeStr = [
          String(hours).padStart(2, '0'),
          String(minutes).padStart(2, '0'),
          String(seconds).padStart(2, '0')
        ].join(':');

        el.textContent = `${timeStr} (Fixed Day Charge: ₹${fixedRate})`;
      });
    }
    setInterval(updateTimers, 1000);
    updateTimers();
  });
</script>
