<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #334155;
      background: #f8fafc;
      margin: 0;
      padding: 2rem 1rem;
      font-size: 14px;
      line-height: 1.5;
    }
    .invoice-box {
      max-width: 840px;
      margin: auto;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 3rem;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      position: relative;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2.5rem;
    }
    .header-table td {
      vertical-align: top;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .brand-name {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.5px;
    }
    .brand-caption {
      font-size: 12px;
      color: #64748b;
      display: block;
      line-height: 1.4;
    }
    .invoice-title {
      text-align: right;
      font-size: 24px;
      font-weight: 800;
      color: #7c3aed;
      letter-spacing: 0.5px;
    }
    .invoice-meta {
      text-align: right;
      font-size: 13px;
      color: #64748b;
      margin-top: 6px;
      line-height: 1.6;
    }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 6px;
    }
    .status-badge.paid {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #86efac;
    }
    .status-badge.pending {
      background: #fef3c7;
      color: #b45309;
      border: 1px solid #fde68a;
    }
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2.5rem;
      background: #f8fafc;
      border-radius: 12px;
      padding: 1.25rem;
      border: 1px solid #f1f5f9;
    }
    .details-table td {
      width: 50%;
      vertical-align: top;
      padding: 1.25rem;
    }
    .details-title {
      font-size: 11px;
      text-transform: uppercase;
      font-weight: 800;
      color: #94a3b8;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }
    .details-body {
      font-size: 13.5px;
      color: #1e293b;
      line-height: 1.6;
    }
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 2rem;
      text-align: left;
    }
    .items-table th {
      background: #f1f5f9;
      border-bottom: 2px solid #cbd5e1;
      padding: 12px 14px;
      font-weight: 700;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #475569;
    }
    .items-table td {
      padding: 16px 14px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 14px;
    }
    .totals-table {
      width: 45%;
      margin-left: auto;
      border-collapse: collapse;
    }
    .totals-table td {
      padding: 8px 14px;
      font-size: 13.5px;
    }
    .totals-table tr.grand-total td {
      border-top: 2px solid #0f172a;
      font-size: 18px;
      font-weight: 800;
      color: #0f172a;
      padding-top: 12px;
    }
    .footer-note {
      text-align: center;
      margin-top: 3.5rem;
      font-size: 12px;
      color: #64748b;
      border-top: 1px dashed #cbd5e1;
      padding-top: 1.5rem;
      line-height: 1.6;
    }
    .print-actions {
      max-width: 840px;
      margin: 0 auto 1.5rem auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .btn-action {
      background: linear-gradient(135deg, #7c3aed, #6d28d9);
      color: #fff;
      padding: 0.7rem 1.6rem;
      border-radius: 10px;
      border: none;
      font-weight: 700;
      cursor: pointer;
      font-size: 14px;
      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.3);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-secondary {
      background: #e2e8f0;
      color: #334155;
      box-shadow: none;
    }
    @media print {
      body {
        background: #fff;
        padding: 0;
      }
      .invoice-box {
        border: none;
        box-shadow: none;
        padding: 0;
      }
      .print-actions {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <div class="print-actions">
    <a href="/client/dashboard" class="btn-action btn-secondary">
      ‹ Return to Dashboard
    </a>
    <button onclick="window.print()" class="btn-action">
      🖨️ Print / Download Official PDF Invoice
    </button>
  </div>

  <div class="invoice-box">
    <!-- Header -->
    <table class="header-table">
      <tr>
        <td>
          <div class="brand-logo">
            <span class="brand-name">SV Personnels</span>
          </div>
          <span class="brand-caption">
            <strong>SV Personnels Private Limited</strong><br>
            Govt. Registered Staffing &amp; Hiring Network<br>
            GSTIN: <strong>07AAAAA0000A1Z5</strong> &bull; HSN/SAC: <strong>998311</strong><br>
            New Delhi, Delhi 110001 &bull; support@svpersonnels.in
          </span>
        </td>
        <td>
          <div class="invoice-title">TAX INVOICE</div>
          <div class="invoice-meta">
            Invoice No: <strong>INV-<%= booking.booking_code %></strong><br>
            Invoice Date: <strong><%= formatShortDate(booking.created_at) %></strong><br>
            Payment Mode: <strong>PayU Live Gateway</strong><br>
            <span class="status-badge <%= (booking.payment_status === 'paid' || booking.payment_status === 'success') ? 'paid' : 'pending' %>">
              ✓ <%= (booking.payment_status === 'paid' || booking.payment_status === 'success') ? 'PAYMENT SUCCESSFUL (PAID)' : 'PAYMENT PENDING' %>
            </span>
          </div>
        </td>
      </tr>
    </table>

    <!-- Billing Details -->
    <table class="details-table">
      <tr>
        <td>
          <div class="details-title">Billed To (Client / Customer)</div>
          <div class="details-body">
            <strong><%= booking.clients ? (booking.clients.full_name || booking.clients.name) : (booking.guestName || booking.guest_name || 'Verified Client') %></strong><br>
            Email: <%= booking.clients ? booking.clients.email : (booking.guestEmail || booking.guest_email || 'client@svpersonnels.in') %><br>
            Phone: <%= booking.clients ? booking.clients.phone : (booking.guestPhone || booking.guest_phone || 'N/A') %><br>
            Address: <%= booking.addressArea || booking.location || 'India' %>
          </div>
        </td>
        <td>
          <div class="details-title">Transaction &amp; Gateway Details</div>
          <div class="details-body">
            PayU Txn ID: <strong><%= booking.txnid || booking.booking_code %></strong><br>
            PayU Reference: <strong><%= booking.mihpayid || 'PAYU_' + booking.booking_code %></strong><br>
            Service Provider: <%= booking.professionals ? (booking.professionals.full_name || booking.professionals.name) : (booking.service_description || 'SV Personnels Staffing Network') %><br>
            Status: <strong style="color: #16a34a;"><%= booking.payment_status || 'Paid Online' %></strong>
          </div>
        </td>
      </tr>
    </table>

    <!-- Items Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th>Description of Service</th>
          <th>Date</th>
          <th>SAC Code</th>
          <th style="text-align: right;">Amount (₹)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <strong><%= booking.service_description || 'Staffing & Hiring Service Platform Fee' %></strong><br>
            <span style="font-size: 12px; color: #64748b;">
              Reference: SV-<%= booking.booking_code %> &bull; Online placement booking &amp; verification
            </span>
          </td>
          <td><%= formatShortDate(booking.created_at) %></td>
          <td>998311</td>
          <td style="text-align: right; font-weight: 700;">₹<%= booking.base_amount || (Number(booking.budget_inr || 50) / 1.18).toFixed(2) %></td>
        </tr>
      </tbody>
    </table>

    <!-- Totals -->
    <table class="totals-table">
      <tr>
        <td style="color: #64748b;">Base Taxable Value</td>
        <td style="text-align: right; font-weight: 600;">₹<%= booking.base_amount || (Number(booking.budget_inr || 50) / 1.18).toFixed(2) %></td>
      </tr>
      <tr>
        <td style="color: #64748b;">CGST (9%)</td>
        <td style="text-align: right; font-weight: 600;">₹<%= (Number(booking.gst_amount || 0) / 2).toFixed(2) %></td>
      </tr>
      <tr>
        <td style="color: #64748b;">SGST (9%)</td>
        <td style="text-align: right; font-weight: 600;">₹<%= (Number(booking.gst_amount || 0) / 2).toFixed(2) %></td>
      </tr>
      <tr class="grand-total">
        <td>Total Paid Amount</td>
        <td style="text-align: right;">₹<%= Number(booking.budget_inr || 50).toFixed(2) %></td>
      </tr>
    </table>

    <!-- Footer Note -->
    <div class="footer-note">
      Thank you for choosing <strong>SV Personnels</strong>. For billing inquiries, email <strong>support@svpersonnels.in</strong>.<br>
      This is an official system-generated GST Tax Invoice issued by SV Personnels Private Limited under IT Act &amp; GST Rules. No physical signature required.
    </div>
  </div>

</body>
</html>
