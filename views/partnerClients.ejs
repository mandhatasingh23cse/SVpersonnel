<section class="section shell" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/partner/dashboard" style="color: var(--color-brand); text-decoration: none; font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.3rem;">
        ‹ Back to Partner Dashboard
      </a>
      <h1 style="color: #fff; font-size: 2.2rem; font-family: 'Outfit', sans-serif; margin: 0.4rem 0 0;">Registered Clients Directory</h1>
      <p style="color: var(--color-ink-light); margin: 0.3rem 0 0; font-size: 0.95rem;">
        🔒 Authorized Verified Agency Portal — View client profiles, track contact status, and filter by city.
      </p>
    </div>
  </div>

  <%- include("partials/notice") %>

  <!-- Search & City Filter Control Panel -->
  <div class="glass-panel" style="padding: 1.5rem 2rem; border-radius: 18px; background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(255,255,255,0.12); margin-bottom: 2rem;">
    <form method="GET" action="/partner/clients" style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.25rem; justify-content: space-between;">
      
      <div style="display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; flex: 1; min-width: 280px;">
        <!-- Google Location Picker City Input -->
        <div style="display: flex; flex-direction: column; gap: 0.35rem; min-width: 220px; flex: 1;">
          <label style="font-size: 0.8rem; font-weight: 700; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em;">📍 Filter City (Google Location)</label>
          <input type="text" id="city" name="city" value="<%= selectedCity %>" placeholder="Click to select city via Google Location..." class="location-input" style="background: rgba(30, 41, 59, 0.9); color: #fff; border: 1px solid rgba(56,189,248,0.3); border-radius: 10px; padding: 0.7rem 1.2rem; font-size: 0.9rem; font-weight: 600; cursor: pointer; width: 100%; box-sizing: border-box;">
        </div>

        <!-- City Filter Dropdown -->
        <div style="display: flex; flex-direction: column; gap: 0.35rem;">
          <label style="font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Quick Cities</label>
          <select id="citySelectFilter" onchange="if(this.value){ document.getElementById('city').value = this.value; this.form.submit(); }" style="background: rgba(30, 41, 59, 0.9); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; padding: 0.7rem 1.2rem; font-size: 0.9rem; font-weight: 600; min-width: 160px; cursor: pointer;">
            <option value="">All Cities</option>
            <% (allCities || []).forEach(function(c) { %>
              <option value="<%= c %>" <%= (selectedCity && selectedCity.toLowerCase() === c.toLowerCase()) ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>

        <!-- Realtime Search Bar -->
        <div style="display: flex; flex-direction: column; gap: 0.35rem; flex: 1; min-width: 180px;">
          <label style="font-size: 0.8rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Instant Search</label>
          <input type="text" id="clientSearchInput" placeholder="Search name, phone, email..." style="background: rgba(30, 41, 59, 0.9); color: #fff; border: 1px solid rgba(255,255,255,0.2); border-radius: 10px; padding: 0.7rem 1.2rem; font-size: 0.9rem; width: 100%; box-sizing: border-box;">
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <button type="submit" class="button button-primary" style="padding: 0.7rem 1.4rem; border-radius: 10px; font-weight: 700; background: linear-gradient(135deg, #38bdf8, #0284c7); color: #0f172a; border: none; cursor: pointer;">
          🔍 Filter
        </button>
        <% if (selectedCity) { %>
          <a href="/partner/clients" style="color: #f43f5e; font-size: 0.85rem; font-weight: 600; text-decoration: none;">✕ Clear</a>
        <% } %>
      </div>

    </form>
  </div>

  <!-- Contact Tracking Filter Tabs & Count Banner -->
  <div style="margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(15, 23, 42, 0.7); padding: 4px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
      <button type="button" class="status-tab-btn active" data-filter="all" style="padding: 0.5rem 1rem; border-radius: 8px; border: none; background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-weight: 700; font-size: 0.85rem; cursor: pointer;">
        All Clients (<span id="countAll"><%= clients ? clients.length : 0 %></span>)
      </button>
      <button type="button" class="status-tab-btn" data-filter="contacted" style="padding: 0.5rem 1rem; border-radius: 8px; border: none; background: transparent; color: #94a3b8; font-weight: 600; font-size: 0.85rem; cursor: pointer;">
        ✅ Contacted (<span id="countContacted">0</span>)
      </button>
      <button type="button" class="status-tab-btn" data-filter="pending" style="padding: 0.5rem 1rem; border-radius: 8px; border: none; background: transparent; color: #94a3b8; font-weight: 600; font-size: 0.85rem; cursor: pointer;">
        ⏳ Pending (<span id="countPending">0</span>)
      </button>
    </div>

    <span style="color: #cbd5e1; font-size: 0.95rem; font-weight: 600;">
      Showing <strong style="color: #38bdf8;" id="visibleCount"><%= clients ? clients.length : 0 %></strong> Client(s) <%= selectedCity ? `in "${selectedCity}"` : '' %>
    </span>
  </div>

  <!-- Clients Table Grid -->
  <% if (!clients || clients.length === 0) { %>
    <div class="glass-panel" style="padding: 3rem; text-align: center; border-radius: 18px; border: 1px dashed rgba(255,255,255,0.15);">
      <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">👥</span>
      <h3 style="color: #fff; margin: 0 0 0.5rem;">No clients found</h3>
      <p style="color: #94a3b8; max-width: 450px; margin: 0 auto 1.5rem; font-size: 0.9rem;">
        <%= selectedCity ? `No registered clients currently listed under "${selectedCity}".` : 'No registered clients found in the platform database.' %>
      </p>
      <% if (selectedCity) { %>
        <a href="/partner/clients" class="button button-secondary" style="padding: 0.6rem 1.2rem; border-radius: 10px; font-size: 0.85rem;">View All Cities</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="glass-panel" style="padding: 0; border-radius: 18px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: rgba(15, 23, 42, 0.8);">
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem;">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.9); border-bottom: 1px solid rgba(255,255,255,0.12); color: #94a3b8; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em;">
              <th style="padding: 1.1rem 1.5rem;">Client Name</th>
              <th style="padding: 1.1rem 1.5rem;">Email Address</th>
              <th style="padding: 1.1rem 1.5rem;">Phone Number</th>
              <th style="padding: 1.1rem 1.5rem;">City</th>
              <th style="padding: 1.1rem 1.5rem;">Contact Tracking</th>
              <th style="padding: 1.1rem 1.5rem; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody id="clientsTableBody">
            <% clients.forEach(function(client) { 
              const contactInfo = (contactedMap && contactedMap[client.id]) ? contactedMap[client.id] : null;
              const isContacted = Boolean(contactInfo && contactInfo.status === 'contacted');
            %>
              <tr class="client-row" data-id="<%= client.id %>" data-name="<%= (client.name || '').toLowerCase() %>" data-email="<%= (client.email || '').toLowerCase() %>" data-phone="<%= (client.phone || '').toLowerCase() %>" data-city="<%= (client.city || '').toLowerCase() %>" data-contacted="<%= isContacted ? 'true' : 'false' %>" style="border-bottom: 1px solid rgba(255,255,255,0.06); transition: background 0.2s;">
                <td style="padding: 1.2rem 1.5rem;">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem;">
                      <%= (client.name || 'C').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <strong style="color: #fff; font-size: 0.98rem; display: block;"><%= client.name %></strong>
                      <span style="font-size: 0.75rem; color: #64748b;">Member since <%= client.createdAt ? new Date(client.createdAt).toLocaleDateString() : 'Recent' %></span>
                    </div>
                  </div>
                </td>
                <td style="padding: 1.2rem 1.5rem;">
                  <a href="mailto:<%= client.email %>" style="color: #38bdf8; text-decoration: none; font-weight: 500;">
                    ✉️ <%= client.email %>
                  </a>
                </td>
                <td style="padding: 1.2rem 1.5rem;">
                  <% if (client.phone && client.phone !== 'N/A') { %>
                    <a href="tel:<%= client.phone %>" style="color: #4ade80; text-decoration: none; font-weight: 600;">
                      📞 <%= client.phone %>
                    </a>
                  <% } else { %>
                    <span style="color: #64748b;">Not Provided</span>
                  <% } %>
                </td>
                <td style="padding: 1.2rem 1.5rem;">
                  <span style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; text-transform: capitalize;">
                    📍 <%= client.city || 'Not Specified' %>
                  </span>
                </td>
                <td style="padding: 1.2rem 1.5rem;">
                  <!-- Contact Bookmark Toggle Pill -->
                  <button type="button" class="bookmark-btn" data-client-id="<%= client.id %>" style="background: <%= isContacted ? 'rgba(34, 197, 94, 0.15)' : 'rgba(255, 255, 255, 0.05)' %>; color: <%= isContacted ? '#4ade80' : '#94a3b8' %>; border: 1px solid <%= isContacted ? 'rgba(34, 197, 94, 0.35)' : 'rgba(255, 255, 255, 0.15)' %>; padding: 6px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
                    <span class="bookmark-icon"><%= isContacted ? '✅' : '🔖' %></span>
                    <span class="bookmark-label"><%= isContacted ? 'Contacted' : 'Mark as Contacted' %></span>
                  </button>
                </td>
                <td style="padding: 1.2rem 1.5rem; text-align: right;">
                  <% if (client.phone && client.phone !== 'N/A') { %>
                    <a href="https://wa.me/91<%= client.phone.replace(/\D/g,'') %>" target="_blank" style="padding: 0.45rem 0.9rem; background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 8px; font-size: 0.8rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
                      💬 WhatsApp
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const searchInput = document.getElementById("clientSearchInput");
    const rows = document.querySelectorAll(".client-row");
    const visibleCount = document.getElementById("visibleCount");
    const tabBtns = document.querySelectorAll(".status-tab-btn");
    const countAllEl = document.getElementById("countAll");
    const countContactedEl = document.getElementById("countContacted");
    const countPendingEl = document.getElementById("countPending");

    let currentTab = "all";

    function updateTabCounts() {
      let total = rows.length;
      let contacted = 0;
      let pending = 0;

      rows.forEach(r => {
        if (r.getAttribute("data-contacted") === "true") contacted++;
        else pending++;
      });

      if (countAllEl) countAllEl.textContent = total;
      if (countContactedEl) countContactedEl.textContent = contacted;
      if (countPendingEl) countPendingEl.textContent = pending;
    }

    function filterRows() {
      const query = (searchInput ? searchInput.value : "").toLowerCase().trim();
      let visible = 0;

      rows.forEach(function(row) {
        const name = row.getAttribute("data-name") || "";
        const email = row.getAttribute("data-email") || "";
        const phone = row.getAttribute("data-phone") || "";
        const city = row.getAttribute("data-city") || "";
        const isContacted = row.getAttribute("data-contacted") === "true";

        let matchesTab = true;
        if (currentTab === "contacted" && !isContacted) matchesTab = false;
        if (currentTab === "pending" && isContacted) matchesTab = false;

        let matchesSearch = !query || (name.includes(query) || email.includes(query) || phone.includes(query) || city.includes(query));

        if (matchesTab && matchesSearch) {
          row.style.display = "";
          visible++;
        } else {
          row.style.display = "none";
        }
      });

      if (visibleCount) visibleCount.textContent = visible;
    }

    updateTabCounts();
    filterRows();

    if (searchInput) {
      searchInput.addEventListener("input", filterRows);
    }

    // Tab buttons handler
    tabBtns.forEach(btn => {
      btn.addEventListener("click", function() {
        tabBtns.forEach(b => {
          b.classList.remove("active");
          b.style.background = "transparent";
          b.style.color = "#94a3b8";
        });
        this.classList.add("active");
        this.style.background = "rgba(56, 189, 248, 0.2)";
        this.style.color = "#38bdf8";
        currentTab = this.getAttribute("data-filter");
        filterRows();
      });
    });

    // Contact Bookmark Toggle Handler
    document.querySelectorAll(".bookmark-btn").forEach(btn => {
      btn.addEventListener("click", async function() {
        const clientId = this.getAttribute("data-client-id");
        const row = this.closest(".client-row");
        const label = this.querySelector(".bookmark-label");
        const icon = this.querySelector(".bookmark-icon");

        this.style.opacity = "0.6";

        try {
          const res = await fetch(`/partner/clients/${clientId}/toggle-contact`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            }
          });
          const data = await res.json();
          this.style.opacity = "1";

          if (data && data.success) {
            const isContacted = data.status === "contacted";
            row.setAttribute("data-contacted", isContacted ? "true" : "false");

            if (isContacted) {
              this.style.background = "rgba(34, 197, 94, 0.15)";
              this.style.color = "#4ade80";
              this.style.borderColor = "rgba(34, 197, 94, 0.35)";
              icon.textContent = "✅";
              label.textContent = "Contacted";
            } else {
              this.style.background = "rgba(255, 255, 255, 0.05)";
              this.style.color = "#94a3b8";
              this.style.borderColor = "rgba(255, 255, 255, 0.15)";
              icon.textContent = "🔖";
              label.textContent = "Mark as Contacted";
            }

            updateTabCounts();
            filterRows();
          }
        } catch (err) {
          this.style.opacity = "1";
          console.error("Failed to toggle contact bookmark:", err);
        }
      });
    });
  });
</script>
